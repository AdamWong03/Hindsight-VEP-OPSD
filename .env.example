# Machine-specific settings for the Hindsight VEP-OPSD scripts.
#
# Copy to .env (git-ignored) and fill in. Every script sources it, and values set
# on the command line or already exported in the environment win over it, so this
# file is only the default source.
#
#   cp .env.example .env && ${EDITOR:-vi} .env

# --- model and data ---------------------------------------------------------
# Qwen3-VL checkpoint directory (config.json + weights).
MODEL=/path/to/Qwen3-VL-8B-Instruct
# Training manifest, see docs/data-format.md. Absolute video paths in the
# manifest need no root; relative ones resolve below VIDEO_ROOT.
DATA=/path/to/VEP-training-manifest.json
VIDEO_ROOT=

# --- output and caches ------------------------------------------------------
# Runs go to $OUTPUT_ROOT/hindsight-vep-opsd/<run>.
OUTPUT_ROOT=/path/to/outputs
# Benchmark data (TwiFF-Bench shards, fetched FutureBench corpus) and caches.
DATA_ROOT=/path/to/data
CACHE_ROOT=/path/to/cache

# --- evaluation -------------------------------------------------------------
TWIFF_BENCH_DIR=/path/to/data/TwiFF-Bench
FUTUREBENCH_DIR=/path/to/data/FutureBench
HF_HOME=/path/to/cache/hf_eval

# --- environment ------------------------------------------------------------
# micromamba environment used by scripts/_env.sh (created by scripts/setup_env.sh).
# Set the absolute prefix when the environment is not in this machine's
# micromamba envs_dirs — job containers, for instance, resolve nothing by name.
VEP_OPSD_ENV_NAME=vep
VEP_OPSD_ENV_PREFIX=/path/to/envs/vep
VEP_OPSD_ENV_BASE=
# Optional PyPI mirror for scripts/setup_env.sh. Leave empty to use pip's default.
PYPI_INDEX=
PYPI_HOST=

# --- TwiFF answer judge -----------------------------------------------------
# Read from here, or from lmms-eval/.env; see scripts/judge_twiff.sh.
OPENAI_API_KEY=EMPTY
OPENAI_API_BASE=http://127.0.0.1:8000/v1
LOCAL_LLM=
